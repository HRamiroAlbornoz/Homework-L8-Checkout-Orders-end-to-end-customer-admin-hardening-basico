rules_version = '2';

// Reglas de seguridad de Firestore para este proyecto. Archivo de referencia
// versionado junto al código (no se despliega automáticamente con `npm run
// dev`/`npm run build`, requiere `firebase deploy --only firestore:rules`
// con el CLI de Firebase inicializado).
//
// Por qué existe este archivo: la UI (Header, AdminRoute) oculta o bloquea
// la navegación según el rol del usuario, pero eso es solo una mejora de UX.
// Nada impide que alguien llame directamente al SDK de Firestore desde la
// consola del navegador. La única protección real contra que un usuario lea
// o escriba datos que no le corresponden es esta capa de reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Funciones auxiliares
    // -----------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Lee el rol del usuario desde su propio documento de perfil.
    //
    // IMPORTANTE (costo): cada get() dentro de una regla cuenta como UNA
    // LECTURA FACTURABLE, y se ejecuta en cada evaluación de la regla. Por eso
    // se llama solo en las reglas de escritura de productos, que son
    // infrecuentes (las hace un admin de vez en cuando), y nunca en las de
    // lectura del catálogo, que se evalúan en cada visita.
    //
    // Si el documento del usuario no existe, get() falla y la regla deniega la
    // operación. Eso es lo correcto: una identidad sin perfil no tiene rol, y
    // asumir uno por defecto sería justamente el agujero a evitar.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    // -----------------------------------------------------------------------
    // Catálogo de productos
    // -----------------------------------------------------------------------

    match /products/{productId} {
      // Lectura pública: el catálogo se muestra sin requerir sesión.
      allow read: if true;

      // Alta desde el panel de administración. Se valida el ROL y también la
      // FORMA del documento: sin la segunda parte, un admin (o alguien con su
      // sesión) podría escribir un producto sin "nameLower" y dejarlo invisible
      // en las búsquedas, o sin "name" y romper el render del catálogo para
      // todos los visitantes.
      allow create: if isAdmin() && isValidProduct(request.resource.data);

      // Editar y eliminar productos no existen todavía en la aplicación. Las
      // reglas reflejan lo que la app realmente hace, no lo que podría llegar a
      // hacer: habilitar por las dudas es exactamente lo contrario al principio
      // de mínimo privilegio.
      allow update, delete: if false;
    }

    function isValidProduct(data) {
      // hasOnly rechaza campos que no estén en la lista. Sin esto, alguien
      // podría inyectar campos arbitrarios en el documento (por ejemplo un
      // "featured: true" que la app no espera) o hacer crecer la base sin
      // control.
      return data.keys().hasOnly(['name', 'nameLower', 'categoryId', 'price', 'imageUrl'])
             && data.name is string
             && data.name.size() > 0
             && data.name.size() <= 120
             && data.nameLower is string
             // nameLower TIENE que ser el nombre en minúsculas. Es un campo
             // técnico que sostiene la búsqueda por prefijo: si se pudiera
             // escribir cualquier cosa ahí, un producto quedaría inencontrable.
             && data.nameLower == data.name.lower()
             && data.categoryId in ['calzado', 'ropa', 'accesorios', 'electronica', 'hogar']
             && data.price is number
             && data.price > 0
             && data.imageUrl is string
             // Solo https: una URL http:// en el atributo src de una <img>
             // dispara advertencias de contenido mixto y puede ser interceptada.
             && data.imageUrl.matches('https://.*');
    }

    // -----------------------------------------------------------------------
    // Órdenes de compra
    // -----------------------------------------------------------------------

    match /orders/{orderId} {
      // -------------------------------------------------------------------
      // LECTURA: el dueño de la orden, o cualquier administrador
      // -------------------------------------------------------------------
      //
      // "resource" es el documento que YA está en la base (a diferencia de
      // "request.resource", que es el que se intenta escribir).
      //
      // ⚠ EL ORDEN DE LAS CONDICIONES IMPORTA, Y CUESTA DINERO.
      //
      // La comparación del userId va PRIMERO y isAdmin() al final, a propósito.
      // isAdmin() hace un get() sobre users/{uid}, y cada get() dentro de una
      // regla es una LECTURA FACTURABLE. Estas expresiones cortocircuitan: si el
      // primer término del || ya es verdadero, el segundo no se evalúa.
      //
      // Con este orden, un cliente que lista sus 20 órdenes no dispara ningún
      // get(). Con el orden invertido, pagaría una lectura extra por cada
      // documento del listado sin obtener nada a cambio.
      //
      // Para una consulta de listado, Firestore evalúa esta regla contra cada
      // documento devuelto: si alguno falla, falla la consulta entera. Por eso
      // un cliente SOLO puede listar con where('userId','==',su uid), mientras
      // que un admin puede listar sin filtro (isAdmin() no depende del
      // documento, así que se cumple para todos).
      allow read: if isSignedIn()
                  && (resource.data.userId == request.auth.uid || isAdmin());

      // -------------------------------------------------------------------
      // CREACIÓN: solo el propio usuario, y siempre en estado inicial
      // -------------------------------------------------------------------
      allow create: if isSignedIn()
                    // hasOnly rechaza cualquier campo que no esté en la lista.
                    // Sin esto, alguien podría llamar al SDK desde la consola
                    // del navegador e inyectar campos que la app no espera (un
                    // "descuento: 100", o un blob de un megabyte).
                    // updatedAt NO está en la lista: una orden recién creada
                    // nunca fue actualizada.
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'items', 'total', 'status', 'createdAt']
                       )
                    // Nadie puede crear una orden a nombre de otro usuario.
                    && request.resource.data.userId == request.auth.uid
                    // El estado inicial siempre es 'pending': así nadie puede
                    // insertar una orden ya marcada como completada.
                    && request.resource.data.status == 'pending'
                    // Patrón oficial de Firebase para confirmar que el campo se
                    // escribió con serverTimestamp() real, y no con una fecha
                    // armada a mano del lado del cliente. Es lo que garantiza
                    // que el orden cronológico del historial sea confiable.
                    && request.resource.data.createdAt == request.time
                    && isValidOrderShape(request.resource.data);

      // -------------------------------------------------------------------
      // ACTUALIZACIÓN: solo un admin, solo el estado, y solo si la transición
      // es válida
      // -------------------------------------------------------------------
      allow update: if isAdmin()
                    // diff().affectedKeys() son los campos EFECTIVAMENTE
                    // MODIFICADOS. Es la diferencia clave con
                    // request.resource.data.keys(), que describe el documento
                    // final completo: con keys() habría que listar todos los
                    // campos de la orden y no se estaría restringiendo nada.
                    //
                    // Con hasOnly, cualquier intento de tocar total, userId,
                    // items o createdAt —solo o junto con status— se rechaza.
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['status', 'updatedAt'])
                    // El estado tiene que cambiar de verdad. Sin esto se podría
                    // "actualizar" una orden sin modificarla, pisando updatedAt
                    // con un cambio que nunca ocurrió.
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['status'])
                    // updatedAt es obligatorio y tiene que venir del servidor.
                    // El enunciado lo da como opcional; acá se exige, porque una
                    // orden que cambió de estado sin dejar constancia de cuándo
                    // es un registro peor que inútil para auditar.
                    && request.resource.data.updatedAt == request.time
                    && isValidTransition(
                         resource.data.status, request.resource.data.status
                       );

      // Una orden es un registro histórico: no se borra nunca. Si hiciera falta
      // "deshacer" una compra, eso es una transición a 'cancelled', que deja
      // rastro — no una eliminación, que lo borra.
      allow delete: if false;
    }

    // Forma mínima válida de una orden.
    //
    // ⚠ LO QUE ESTAS REGLAS **NO** PUEDEN VERIFICAR
    //
    // El lenguaje de las reglas no permite RECORRER un array: no hay bucles ni
    // funciones tipo map/reduce. Por eso acá se valida que "items" sea una lista
    // con una cantidad razonable de elementos, pero NO se puede comprobar la
    // forma de cada ítem, ni contrastar su precio contra products, ni verificar
    // que "total" sea la suma de las líneas.
    //
    // Es una consecuencia directa del modelo que pide el enunciado (ítems
    // embebidos en la orden). El proyecto anterior guardaba cada ítem como un
    // documento propio en una subcolección justamente para poder verificar su
    // precio con un get() — cosa que acá deja de ser posible.
    //
    // El trade-off está documentado en docs/ai-notes.md y en src/types/order.ts.
    function isValidOrderShape(data) {
      return data.userId is string
             && data.userId.size() > 0
             && data.total is number
             && data.total >= 0
             && data.items is list
             && data.items.size() > 0
             // Mismo tope que MAX_ITEMS_PER_ORDER en src/types/order.ts. Está
             // duplicado a propósito: las reglas no pueden importar código de la
             // app, y este es el único lugar donde el límite se aplica de verdad.
             && data.items.size() <= 50;
    }

    // Transiciones permitidas entre estados.
    //
    // Réplica exacta de src/features/orders/orderTransitions.ts. La duplicación
    // es deliberada y necesaria: deshabilitar una opción en el <select> ayuda al
    // usuario honesto, pero no detiene a nadie que llame al SDK desde la consola
    // del navegador. Esta copia es la que se aplica de verdad.
    //
    // 'completed' y 'cancelled' son terminales: no aparecen como origen en
    // ninguna rama, así que cualquier intento de salir de ellos devuelve false.
    // Eso también impide "descancelar" una orden.
    //
    // SI SE CAMBIAN LAS TRANSICIONES EN EL CÓDIGO, HAY QUE CAMBIARLAS ACÁ.
    function isValidTransition(current, next) {
      return (current == 'pending' && next in ['processing', 'cancelled'])
             || (current == 'processing' && next in ['completed', 'cancelled']);
    }

    // -----------------------------------------------------------------------
    // Perfiles de usuario
    // -----------------------------------------------------------------------

    match /users/{uid} {
      // Un usuario solo puede leer su propio perfil.
      //
      // ⚠ ESTA REGLA SOSTIENE LA SUBIDA DE IMÁGENES. No es solo para la app.
      //
      // La Vercel Function de api/uploads/presign.ts lee este documento para
      // averiguar si quien pide subir una imagen es admin, y lo hace con el
      // token DEL PROPIO USUARIO — no con credenciales de administrador. O sea
      // que es esta regla la que autoriza esa lectura.
      //
      // Consecuencia práctica: si se restringe o se elimina, el panel de
      // administración deja de poder subir imágenes, y el fallo aparece como un
      // error del servidor sin relación aparente con las reglas.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Alta del perfil: solo el propio usuario recién creado en Auth puede
      // crear su documento (nunca en nombre de otro uid), y el rol queda
      // forzado a "customer" a nivel de reglas — coincide con
      // createUserProfile(), que nunca acepta el rol como parámetro externo,
      // pero esta regla es la que de verdad lo garantiza aunque alguien
      // intente escribir directo con el SDK, sin pasar por la app.
      //
      // Además de "role", se valida la forma completa del documento: sin
      // esto, alguien podría escribir { role: "customer" } a secas (pasando
      // la regla) y crear un perfil sin email/displayName/createdAt, que
      // después rompe la lectura (userDocSchema.parse falla) dejando la
      // cuenta inutilizable de forma permanente.
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == 'customer'
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 0
                    && request.resource.data.displayName is string
                    && request.resource.data.createdAt == request.time;

      // Actualización: el dueño del documento puede modificar su propio
      // perfil, pero el campo "role" tiene que quedar exactamente igual al
      // valor que ya tenía. Así, aunque alguien intente hacer
      // updateDoc(doc(db, "users", miUid), { role: "admin" }) directamente
      // desde la consola del navegador, Firestore rechaza la escritura.
      // Un ascenso real a "admin" solo puede hacerse manualmente desde la
      // Firebase Console (como indica el enunciado del homework), nunca
      // desde el cliente.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      // Sin baja de perfiles: no hay ningún flujo de "eliminar cuenta" en
      // la app todavía.
      allow delete: if false;
    }
  }
}
